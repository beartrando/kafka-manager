      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "@shared/logger": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.28.4"
}
