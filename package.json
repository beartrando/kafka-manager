{
  "name": "@shared/kafka-manager",
  "version": "1.0.0",
  "description": "Shared Kafka producer/consumer manager",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beartrando/kafka-manager.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
